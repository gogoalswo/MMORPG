{
  "name": "mmorpg",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w @mmo/server",
    "test": "node --test \"packages/**/*.test.ts\"",
    "server": "node scripts/serve.mjs",
    "server:raw": "npm run dev -w @mmo/server",
    "probe": "node scripts/probe.mjs",
    "compress": "node scripts/compress-textures.mjs",
    "export:godot": "node scripts/export-shared.mjs",
    "sync:godot": "node scripts/sync-godot-assets.mjs",
    "test:godot": "bash scripts/godot-test.sh"
  },
  "devDependencies": {
    "ktx2-encoder": "^0.6.0",
    "sharp": "^0.35.4"
  }
}
