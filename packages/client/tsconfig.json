{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    // 로컬 모드가 서버 코드(ZoneRoom)를 같이 타입 검사한다. Node 전용 모듈은
    // 브라우저 대체물로 본다 — vite.config.ts 의 alias 와 같은 표다.
    "paths": {
      "colyseus": ["./src/net/local/shims/colyseus.ts"],
      "node:sqlite": ["./src/net/local/shims/sqlite.ts"],
      "node:crypto": ["./src/net/local/shims/crypto.ts"],
      "node:fs": ["./src/net/local/shims/node.ts"],
      "node:path": ["./src/net/local/shims/node.ts"]
    }
  },
  "include": ["src"]
}
